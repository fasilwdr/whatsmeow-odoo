<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="module_category_whatsmeow" model="ir.module.category">
    <field name="name">WhatsApp</field>
    <field name="description">Manage whatsmeow gateways, sessions and messages.</field>
    <field name="sequence">60</field>
  </record>

  <!-- Odoo 16: a group carries its module category directly (there is no
       res.groups.privilege, which arrived in 19), and res.groups has no
       `sequence` — the two groups are ordered by `implied_ids`, Administrator
       implying User. -->
  <record id="group_whatsmeow_user" model="res.groups">
    <field name="name">User</field>
    <field name="category_id" ref="module_category_whatsmeow"/>
    <field name="comment">Can read sessions and send/receive WhatsApp messages.</field>
  </record>

  <record id="group_whatsmeow_manager" model="res.groups">
    <field name="name">Administrator</field>
    <field name="category_id" ref="module_category_whatsmeow"/>
    <field name="implied_ids" eval="[(4, ref('whatsmeow.group_whatsmeow_user'))]"/>
    <field name="comment">Can configure gateways (URL, API key, webhook secret) and sessions.</field>
    <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
  </record>

  <record id="base.group_system" model="res.groups">
    <field name="implied_ids" eval="[(4, ref('whatsmeow.group_whatsmeow_manager'))]"/>
  </record>
</odoo>
