<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="cron_whatsmeow_send_queue" model="ir.cron">
    <field name="name">Whatsmeow: process outgoing queue</field>
    <field name="model_id" ref="model_whatsmeow_message"/>
    <field name="state">code</field>
    <field name="code">model.cron_process_outgoing()</field>
    <field name="interval_number">1</field>
    <field name="interval_type">minutes</field>
    <field name="active" eval="True"/>
  </record>

  <record id="cron_whatsmeow_fetch_media" model="ir.cron">
    <field name="name">Whatsmeow: download inbound media</field>
    <field name="model_id" ref="model_whatsmeow_message"/>
    <field name="state">code</field>
    <field name="code">model.cron_fetch_media()</field>
    <field name="interval_number">1</field>
    <field name="interval_type">minutes</field>
    <field name="active" eval="True"/>
  </record>

  <record id="cron_whatsmeow_check_numbers" model="ir.cron">
    <field name="name">Whatsmeow: validate queued recipients</field>
    <field name="model_id" ref="model_whatsmeow_message"/>
    <field name="state">code</field>
    <field name="code">model.cron_check_numbers()</field>
    <field name="interval_number">15</field>
    <field name="interval_type">minutes</field>
    <field name="active" eval="True"/>
  </record>

  <record id="cron_whatsmeow_refresh_sessions" model="ir.cron">
    <field name="name">Whatsmeow: refresh session status</field>
    <field name="model_id" ref="model_whatsmeow_session"/>
    <field name="state">code</field>
    <field name="code">model.cron_refresh_all()</field>
    <field name="interval_number">5</field>
    <field name="interval_type">minutes</field>
    <field name="active" eval="True"/>
  </record>
</odoo>
