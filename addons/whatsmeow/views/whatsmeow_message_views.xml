<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="whatsmeow_message_view_form" model="ir.ui.view">
    <field name="name">whatsmeow.message.form</field>
    <field name="model">whatsmeow.message</field>
    <field name="arch" type="xml">
      <form>
        <header>
          <button name="action_send" type="object" string="Send" class="btn-primary"
                  invisible="direction != 'out' or state not in ('outgoing', 'error')"/>
          <button name="action_reply" type="object" string="Reply" class="btn-primary"
                  invisible="not can_reply"/>
          <field name="can_reply" invisible="1"/>
          <field name="state" widget="statusbar"
                 statusbar_visible="outgoing,sent,delivered,read"/>
        </header>
        <sheet>
          <group>
            <group>
              <field name="session_id" options="{'no_create': True}"
                     readonly="state != 'outgoing'"/>
              <field name="direction" readonly="state != 'outgoing'"/>
              <field name="message_type" readonly="state != 'outgoing'"/>
              <field name="partner_id" readonly="state != 'outgoing'"/>
              <field name="phone" readonly="state != 'outgoing'"
                     placeholder="447700900123"/>
              <field name="sender_lid" invisible="not sender_lid"/>
              <div colspan="2" class="text-muted"
                   invisible="direction != 'in' or phone or not sender_lid">
                WhatsApp identified this sender only by LID and did not reveal a
                phone number, so no contact could be matched. You can still reply:
                the message is addressed to the chat, not to a number.
              </div>
            </group>
            <group>
              <field name="chat_type"/>
              <field name="chat_name" invisible="chat_type != 'group'"/>
              <field name="chat_jid" readonly="direction == 'in' or state != 'outgoing'"
                     placeholder="120363000000000000@g.us"/>
              <field name="sender_jid" invisible="direction != 'in'"/>
              <field name="reply_to_id" invisible="not reply_to_id"
                     readonly="state != 'outgoing'"/>
              <field name="wa_message_id"/>
              <field name="media_state" invisible="message_type == 'text'"/>
              <field name="media_mimetype" invisible="message_type == 'text'"/>
              <field name="media_size" invisible="message_type == 'text'"/>
              <field name="media_duration"
                     invisible="message_type not in ('audio', 'video')"/>
              <field name="is_voice_note" invisible="message_type != 'audio'"
                     readonly="direction == 'in'"/>
              <field name="error_message" invisible="state != 'error' and media_state != 'error'"
                     class="text-danger"/>
            </group>
          </group>
          <group string="Media" invisible="message_type == 'text'">
            <field name="media_data" filename="media_filename" nolabel="1"
                   readonly="direction == 'in'"/>
            <field name="media_filename" invisible="1"/>
            <div colspan="2" class="text-muted" invisible="media_state != 'pending'">
              Waiting for the scheduled action to download this file from the gateway.
            </div>
          </group>
          <group string="Message">
            <field name="body" nolabel="1" readonly="state != 'outgoing'"
                   placeholder="Message text, or a caption for media..."/>
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <record id="whatsmeow_message_view_list" model="ir.ui.view">
    <field name="name">whatsmeow.message.list</field>
    <field name="model">whatsmeow.message</field>
    <field name="arch" type="xml">
      <list decoration-danger="state == 'error'" decoration-muted="state == 'outgoing'">
        <field name="create_date" string="Date"/>
        <field name="session_id"/>
        <field name="direction"/>
        <field name="message_type"/>
        <field name="chat_type" widget="badge" optional="show"/>
        <field name="chat_name" string="Group" optional="show"/>
        <field name="partner_id"/>
        <field name="phone"/>
        <field name="body" string="Message / Caption"/>
        <field name="media_state" widget="badge" optional="show"
               decoration-warning="media_state == 'pending'"
               decoration-danger="media_state == 'error'"/>
        <field name="state" widget="badge"
               decoration-success="state in ('delivered', 'read')"
               decoration-danger="state == 'error'"/>
        <button name="action_send" type="object" string="Send" icon="fa-paper-plane"
                invisible="direction != 'out' or state not in ('outgoing', 'error')"/>
        <button name="action_reply" type="object" string="Reply" icon="fa-reply"
                invisible="not can_reply"/>
        <field name="can_reply" column_invisible="1"/>
      </list>
    </field>
  </record>

  <record id="whatsmeow_message_view_search" model="ir.ui.view">
    <field name="name">whatsmeow.message.search</field>
    <field name="model">whatsmeow.message</field>
    <field name="arch" type="xml">
      <search>
        <field name="phone"/>
        <field name="sender_lid"/>
        <field name="body"/>
        <field name="partner_id"/>
        <field name="session_id"/>
        <field name="chat_name" string="Group"/>
        <field name="chat_jid"/>
        <filter name="unmatched" string="No Contact Matched"
                domain="[('direction','=','in'), ('partner_id','=',False)]"/>
        <separator/>
        <filter name="groups" string="Group Chats" domain="[('chat_type','=','group')]"/>
        <filter name="private" string="Private Chats" domain="[('chat_type','=','private')]"/>
        <separator/>
        <filter name="incoming" string="Incoming" domain="[('direction','=','in')]"/>
        <filter name="outgoing" string="Outgoing" domain="[('direction','=','out')]"/>
        <separator/>
        <filter name="failed" string="Failed" domain="[('state','=','error')]"/>
        <filter name="queued" string="Queued" domain="[('state','=','outgoing')]"/>
        <separator/>
        <filter name="has_media" string="With Media" domain="[('message_type','!=','text')]"/>
        <filter name="media_pending" string="Media Not Downloaded"
                domain="[('media_state','in',('pending','error'))]"/>
        <group name="group_by">
          <filter name="group_type" string="Type" domain="[]" context="{'group_by': 'message_type'}"/>
          <filter name="group_chat_type" string="Chat Type" domain="[]" context="{'group_by': 'chat_type'}"/>
          <filter name="group_chat" string="Chat" domain="[]" context="{'group_by': 'chat_name'}"/>
          <filter name="group_session" string="Session" domain="[]" context="{'group_by': 'session_id'}"/>
          <filter name="group_partner" string="Contact" domain="[]" context="{'group_by': 'partner_id'}"/>
          <filter name="group_state" string="Status" domain="[]" context="{'group_by': 'state'}"/>
        </group>
      </search>
    </field>
  </record>

  <record id="whatsmeow_message_action" model="ir.actions.act_window">
    <field name="name">Messages</field>
    <field name="res_model">whatsmeow.message</field>
    <field name="view_mode">list,form</field>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">No messages yet</p>
      <p>Outgoing messages are queued and sent by a scheduled action, or immediately with Send.</p>
    </field>
  </record>
</odoo>
