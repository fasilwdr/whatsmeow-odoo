<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

  <t t-inherit="mail.Message" t-inherit-mode="extension">
    <!-- Tag the root so the stylesheet can tint the bubble; the chatter's own
         notes and comments are already colour-coded, so WhatsApp gets its own. -->
    <xpath expr="//div[hasclass('o-mail-Message')]" position="attributes">
      <attribute name="t-att-data-whatsmeow">message.message_type === 'whatsmeow' ? '1' : undefined</attribute>
    </xpath>

    <!-- Badge the author, the way a sent email is badged, so a WhatsApp entry
         is distinguishable from an ordinary note at a glance. Wording is
         direction-neutral: core badges the inbound messages it posts to a
         contact's chatter, and whatsmeow_template badges the outgoing sends it
         logs on a record. -->
    <xpath expr="//span[hasclass('o-mail-Message-author')]" position="after">
      <i t-if="message.message_type === 'whatsmeow'"
         class="fa fa-whatsapp o-whatsmeow-badge me-1"
         title="Via WhatsApp" role="img" aria-label="Via WhatsApp"/>
    </xpath>
  </t>

</templates>
