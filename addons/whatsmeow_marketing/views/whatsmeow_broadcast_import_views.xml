<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <record id="whatsmeow_broadcast_import_view_form" model="ir.ui.view">
    <field name="name">whatsmeow.broadcast.import.form</field>
    <field name="model">whatsmeow.broadcast.import</field>
    <field name="arch" type="xml">
      <form string="Upload Broadcast List">
        <field name="state" invisible="1"/>

        <div invisible="state != 'upload'">
          <div class="alert alert-info" role="status">
            One sheet, three columns: <b>Broadcast Name</b>, <b>Name</b>,
            <b>Phone</b>. Leave the broadcast name empty to keep adding to the
            list named above it, and write the number with its country code.
            A number you already have is reused, never duplicated — and a
            contact who opted out stays opted out.
            <div class="mt-2">
              <!--
                A plain link, not a button returning an act_url: that goes
                through window.open() after an RPC, which a popup blocker eats.
                This is the click itself.

                `download` is what keeps it a download instead of a navigation.
                Without it the browser leaves the page before it knows the
                response is a file, and the half-filled wizard makes Odoo's
                beforeunload guard ask "Leave site?" over a link that never
                actually leaves.
              -->
              <a class="btn btn-secondary btn-sm" role="button"
                 download="broadcast_import_template.xlsx"
                 href="/whatsmeow_marketing/static/xlx/broadcast_import_template.xlsx">
                <i class="fa fa-download me-1" role="img" aria-label="Download"
                   title="Download"/>Download the template
              </a>
            </div>
          </div>
          <group>
            <group>
              <field name="file" filename="filename" required="1"/>
              <field name="filename" invisible="1"/>
            </group>
            <group>
              <field name="default_list_id"
                     options='{"no_open": True}'/>
              <field name="update_names"/>
            </group>
          </group>
        </div>

        <div invisible="state != 'done'">
          <div class="alert alert-success" role="status">
            <field name="result_summary" nolabel="1" readonly="1"
                   widget="text" class="mb-0"/>
          </div>
          <group string="Skipped Rows" invisible="not skipped_summary">
            <field name="skipped_summary" nolabel="1" readonly="1"/>
          </group>
          <field name="imported_list_ids" invisible="1"/>
        </div>

        <footer>
          <button name="action_import" type="object" string="Import"
                  class="btn-primary" data-hotkey="q"
                  invisible="state != 'upload'"/>
          <button name="action_open_lists" type="object" string="View Lists"
                  class="btn-primary" invisible="state != 'done'"/>
          <button string="Close" class="btn-secondary" special="cancel"
                  data-hotkey="x"/>
        </footer>
      </form>
    </field>
  </record>

  <record id="whatsmeow_broadcast_import_action" model="ir.actions.act_window">
    <field name="name">Upload Broadcast List</field>
    <field name="res_model">whatsmeow.broadcast.import</field>
    <field name="view_mode">form</field>
    <field name="view_id" ref="whatsmeow_broadcast_import_view_form"/>
    <field name="target">new</field>
  </record>

</odoo>
