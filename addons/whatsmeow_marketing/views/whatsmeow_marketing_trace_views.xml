<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <record id="whatsmeow_marketing_trace_view_list" model="ir.ui.view">
    <field name="name">whatsmeow.marketing.trace.list</field>
    <field name="model">whatsmeow.marketing.trace</field>
    <field name="arch" type="xml">
      <list string="Campaign Recipients" create="false">
        <field name="campaign_id" optional="hide"/>
        <field name="partner_id" optional="show"/>
        <field name="contact_id" optional="show"/>
        <field name="phone"/>
        <field name="sent_date" optional="show"/>
        <field name="state" widget="badge"
               decoration-success="state in ('delivered', 'read')"
               decoration-info="state in ('sent', 'queued')"
               decoration-danger="state == 'failed'"
               decoration-muted="state in ('skipped', 'cancelled', 'pending')"/>
        <field name="replied" widget="boolean_toggle" optional="show"/>
        <field name="skip_reason" optional="hide"/>
        <field name="failure_reason" optional="hide"/>
      </list>
    </field>
  </record>

  <record id="whatsmeow_marketing_trace_view_form" model="ir.ui.view">
    <field name="name">whatsmeow.marketing.trace.form</field>
    <field name="model">whatsmeow.marketing.trace</field>
    <field name="arch" type="xml">
      <form string="Campaign Recipient" create="false" edit="false">
        <header>
          <button name="action_open_message" type="object" string="Open Message"
                  invisible="not message_id"/>
          <field name="state" widget="statusbar"
                 statusbar_visible="pending,queued,sent,delivered,read"/>
        </header>
        <sheet>
          <group>
            <group>
              <field name="campaign_id"/>
              <field name="partner_id"/>
              <field name="contact_id"/>
              <field name="phone"/>
            </group>
            <group>
              <field name="message_id"/>
              <field name="sent_date"/>
              <field name="skip_reason" invisible="not skip_reason"/>
              <field name="failure_reason" invisible="not failure_reason"/>
              <field name="replied"/>
              <field name="replied_date" invisible="not replied"/>
              <field name="reply_message_id" invisible="not replied"/>
            </group>
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <record id="whatsmeow_marketing_trace_view_search" model="ir.ui.view">
    <field name="name">whatsmeow.marketing.trace.search</field>
    <field name="model">whatsmeow.marketing.trace</field>
    <field name="arch" type="xml">
      <search string="Campaign Recipients">
        <field name="campaign_id"/>
        <field name="partner_id"/>
        <field name="contact_id"/>
        <field name="phone" filter_domain="[('phone', 'ilike', self)]"/>
        <filter name="replied" string="Replied" domain="[('replied', '=', True)]"/>
        <filter name="failed" string="Failed" domain="[('state', '=', 'failed')]"/>
        <filter name="skipped" string="Skipped"
                domain="[('state', 'in', ('skipped', 'cancelled'))]"/>
        <group name="group_by">
          <filter name="group_campaign" string="Campaign" context="{'group_by': 'campaign_id'}"/>
          <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
          <filter name="group_reason" string="Skip Reason" context="{'group_by': 'skip_reason'}"/>
        </group>
      </search>
    </field>
  </record>

  <record id="whatsmeow_marketing_trace_view_graph" model="ir.ui.view">
    <field name="name">whatsmeow.marketing.trace.graph</field>
    <field name="model">whatsmeow.marketing.trace</field>
    <field name="arch" type="xml">
      <graph string="Campaign Results" type="bar" stacked="1" sample="1">
        <field name="campaign_id"/>
        <field name="state"/>
      </graph>
    </field>
  </record>

  <record id="whatsmeow_marketing_trace_view_pivot" model="ir.ui.view">
    <field name="name">whatsmeow.marketing.trace.pivot</field>
    <field name="model">whatsmeow.marketing.trace</field>
    <field name="arch" type="xml">
      <pivot string="Campaign Results" sample="1">
        <field name="campaign_id" type="row"/>
        <field name="state" type="col"/>
      </pivot>
    </field>
  </record>

  <record id="whatsmeow_marketing_trace_action" model="ir.actions.act_window">
    <field name="name">Recipients</field>
    <field name="res_model">whatsmeow.marketing.trace</field>
    <field name="view_mode">list,graph,pivot,form</field>
    <field name="context">{'search_default_group_campaign': 1}</field>
  </record>

</odoo>
