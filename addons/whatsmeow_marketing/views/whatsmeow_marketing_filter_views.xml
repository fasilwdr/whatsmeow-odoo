<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <record id="whatsmeow_marketing_filter_view_list" model="ir.ui.view">
    <field name="name">whatsmeow.marketing.filter.list</field>
    <field name="model">whatsmeow.marketing.filter</field>
    <field name="arch" type="xml">
      <list string="Dynamic Lists">
        <field name="name"/>
        <field name="model_id"/>
        <field name="recipient_count" string="Matches"/>
        <field name="create_uid"/>
      </list>
    </field>
  </record>

  <record id="whatsmeow_marketing_filter_view_form" model="ir.ui.view">
    <field name="name">whatsmeow.marketing.filter.form</field>
    <field name="model">whatsmeow.marketing.filter</field>
    <field name="arch" type="xml">
      <form string="Dynamic List">
        <sheet>
          <div class="oe_title">
            <label for="name"/>
            <h1><field name="name" placeholder="e.g. Customers in Riyadh"/></h1>
          </div>
          <group>
            <group>
              <field name="model_id" options="{'no_create': True}"/>
              <field name="model" invisible="1"/>
              <field name="create_uid"/>
            </group>
            <group>
              <field name="recipient_count" string="Matches right now"/>
            </group>
          </group>
          <field name="mailing_domain" widget="domain"
                 options="{'model': 'model', 'in_dialog': True}"/>
          <div class="text-muted mt-2">
            A dynamic list is re-evaluated every time a campaign uses it, so a
            campaign sent next month reaches whoever matches then — not whoever
            matched today.
          </div>
        </sheet>
      </form>
    </field>
  </record>

  <record id="whatsmeow_marketing_filter_action" model="ir.actions.act_window">
    <field name="name">Dynamic Lists</field>
    <field name="res_model">whatsmeow.marketing.filter</field>
    <field name="view_mode">list,form</field>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">Save an audience</p>
      <p>
        A dynamic list is a saved filter over your contacts. Unlike a broadcast
        list it holds no names: it is re-evaluated at send time, so it always
        reflects the data.
      </p>
    </field>
  </record>

</odoo>
