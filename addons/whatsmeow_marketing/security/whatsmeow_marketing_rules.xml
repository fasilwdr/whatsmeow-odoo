<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data noupdate="0">

    <!-- Record rules are OR-ed across a user's groups, so the manager's own
         rule is what lets them see everything: the user rule must NOT be
         global, or it would clamp managers down to their own records too. -->

    <record id="whatsmeow_marketing_campaign_rule_user" model="ir.rule">
      <field name="name">Campaign: own only</field>
      <field name="model_id" ref="model_whatsmeow_marketing_campaign"/>
      <field name="domain_force">[('user_id', '=', user.id)]</field>
      <field name="groups" eval="[(4, ref('group_whatsmeow_marketing_user'))]"/>
    </record>

    <record id="whatsmeow_marketing_campaign_rule_manager" model="ir.rule">
      <field name="name">Campaign: all</field>
      <field name="model_id" ref="model_whatsmeow_marketing_campaign"/>
      <field name="domain_force">[(1, '=', 1)]</field>
      <field name="groups" eval="[(4, ref('group_whatsmeow_marketing_manager'))]"/>
    </record>

    <record id="whatsmeow_marketing_trace_rule_user" model="ir.rule">
      <field name="name">Trace: own campaigns only</field>
      <field name="model_id" ref="model_whatsmeow_marketing_trace"/>
      <field name="domain_force">[('campaign_id.user_id', '=', user.id)]</field>
      <field name="groups" eval="[(4, ref('group_whatsmeow_marketing_user'))]"/>
    </record>

    <record id="whatsmeow_marketing_trace_rule_manager" model="ir.rule">
      <field name="name">Trace: all</field>
      <field name="model_id" ref="model_whatsmeow_marketing_trace"/>
      <field name="domain_force">[(1, '=', 1)]</field>
      <field name="groups" eval="[(4, ref('group_whatsmeow_marketing_manager'))]"/>
    </record>

    <record id="whatsmeow_broadcast_contact_rule_user" model="ir.rule">
      <field name="name">Broadcast contact: own only</field>
      <field name="model_id" ref="model_whatsmeow_broadcast_contact"/>
      <field name="domain_force">[('user_id', '=', user.id)]</field>
      <field name="groups" eval="[(4, ref('group_whatsmeow_marketing_user'))]"/>
    </record>

    <record id="whatsmeow_broadcast_contact_rule_manager" model="ir.rule">
      <field name="name">Broadcast contact: all</field>
      <field name="model_id" ref="model_whatsmeow_broadcast_contact"/>
      <field name="domain_force">[(1, '=', 1)]</field>
      <field name="groups" eval="[(4, ref('group_whatsmeow_marketing_manager'))]"/>
    </record>

    <record id="whatsmeow_broadcast_list_rule_user" model="ir.rule">
      <field name="name">Broadcast list: own only</field>
      <field name="model_id" ref="model_whatsmeow_broadcast_list"/>
      <field name="domain_force">[('user_id', '=', user.id)]</field>
      <field name="groups" eval="[(4, ref('group_whatsmeow_marketing_user'))]"/>
    </record>

    <record id="whatsmeow_broadcast_list_rule_manager" model="ir.rule">
      <field name="name">Broadcast list: all</field>
      <field name="model_id" ref="model_whatsmeow_broadcast_list"/>
      <field name="domain_force">[(1, '=', 1)]</field>
      <field name="groups" eval="[(4, ref('group_whatsmeow_marketing_manager'))]"/>
    </record>

    <record id="whatsmeow_broadcast_subscription_rule_user" model="ir.rule">
      <field name="name">Subscription: own contacts only</field>
      <field name="model_id" ref="model_whatsmeow_broadcast_subscription"/>
      <field name="domain_force">[('contact_id.user_id', '=', user.id)]</field>
      <field name="groups" eval="[(4, ref('group_whatsmeow_marketing_user'))]"/>
    </record>

    <record id="whatsmeow_broadcast_subscription_rule_manager" model="ir.rule">
      <field name="name">Subscription: all</field>
      <field name="model_id" ref="model_whatsmeow_broadcast_subscription"/>
      <field name="domain_force">[(1, '=', 1)]</field>
      <field name="groups" eval="[(4, ref('group_whatsmeow_marketing_manager'))]"/>
    </record>

  </data>
</odoo>
