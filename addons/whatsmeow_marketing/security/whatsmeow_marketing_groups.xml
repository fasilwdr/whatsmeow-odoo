<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <!-- A privilege of its own, under the connector's existing category:
       marketing access is orthogonal to connector access, and a campaign
       manager has no business reading a gateway's API key. -->
  <record id="res_groups_privilege_whatsmeow_marketing" model="res.groups.privilege">
    <field name="name">WhatsApp Marketing</field>
    <field name="sequence">20</field>
    <field name="category_id" ref="whatsmeow.module_category_whatsmeow"/>
  </record>

  <record id="group_whatsmeow_marketing_user" model="res.groups">
    <field name="name">User</field>
    <field name="sequence">10</field>
    <field name="privilege_id" ref="res_groups_privilege_whatsmeow_marketing"/>
    <!-- Sending needs the connector's own rights: read a session, create a
         message. Nothing here grants gateway configuration. -->
    <field name="implied_ids" eval="[(4, ref('whatsmeow.group_whatsmeow_user'))]"/>
    <field name="comment">Can run WhatsApp campaigns, and sees only their own campaigns and broadcast contacts.</field>
  </record>

  <record id="group_whatsmeow_marketing_manager" model="res.groups">
    <field name="name">Administrator</field>
    <field name="sequence">20</field>
    <field name="privilege_id" ref="res_groups_privilege_whatsmeow_marketing"/>
    <field name="implied_ids"
           eval="[(4, ref('whatsmeow_marketing.group_whatsmeow_marketing_user'))]"/>
    <field name="comment">Sees every campaign, broadcast list and contact, and maintains the dynamic lists.</field>
  </record>

  <record id="base.group_system" model="res.groups">
    <field name="implied_ids"
           eval="[(4, ref('whatsmeow_marketing.group_whatsmeow_marketing_manager'))]"/>
  </record>

</odoo>
