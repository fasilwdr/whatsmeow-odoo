<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
  <!-- The text a point of sale sends when its own template is left empty.
       noupdate: a shop that rewords these must not get them reset by an
       upgrade. -->
  <record id="template_pos_receipt" model="whatsmeow.template">
    <field name="name">POS Receipt</field>
    <field name="model_id" ref="point_of_sale.model_pos_order"/>
    <field name="body">Thank you for shopping at {{ object.company_id.name }}! Your receipt {{ object.pos_reference }} is attached.</field>
  </record>

  <record id="template_pos_invoice" model="whatsmeow.template">
    <field name="name">POS Invoice</field>
    <field name="model_id" ref="account.model_account_move"/>
    <field name="report_id" ref="account.account_invoices"/>
    <field name="body">Here is your invoice {{ object.name }} from {{ object.company_id.name }}.</field>
  </record>
</odoo>
