<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

  <!--
    The stock TextField markup, plus a toolbar floating over the selection.
    `t-on-select` fires for mouse drags, shift-arrows and select-all alike, so
    one handler covers every way a selection can appear.
  -->
  <t t-name="whatsmeow_template.WhatsmeowBodyField">
    <t t-if="props.readonly">
      <span t-esc="props.record.data[props.name] or ''"/>
    </t>
    <t t-else="">
      <div t-ref="div" class="o_whatsmeow_body position-relative">
        <textarea class="o_input"
                  t-att-class="{ 'o_field_translate': isTranslatable }"
                  t-att-id="props.id"
                  t-att-placeholder="props.placeholder"
                  t-att-rows="rowCount"
                  t-ref="textarea"
                  t-on-select="onSelect"
                  t-on-blur="onBlur"/>
        <div t-if="toolbar.visible"
             class="o_whatsmeow_body_toolbar btn-group btn-group-sm shadow-sm position-absolute"
             t-attf-style="top: {{ toolbar.top }}px; left: {{ toolbar.left }}px;"
             role="toolbar"
             aria-label="WhatsApp formatting"
             t-on-mousedown.prevent="() => {}">
          <!--
            Preventing mousedown is load-bearing, not tidiness: without it the
            textarea blurs and the selection is gone before the click handler
            runs, so every button would act on an empty range.

            The buttons are a whitelist of what WhatsApp has. There is
            deliberately no underline (WhatsApp has none, so it would silently
            vanish on the recipient's phone) and no link button (WhatsApp
            auto-links bare URLs but has no anchor text).
          -->
          <button t-foreach="marks" t-as="mark" t-key="mark.name"
                  type="button"
                  class="btn btn-light"
                  t-att-title="mark.title"
                  t-att-disabled="isDisabled(mark.name)"
                  t-on-click="() => this.onClickMark(mark.name)">
            <i class="fa" t-att-class="mark.icon" role="img"/>
          </button>
        </div>
        <div class="o_field_input_buttons">
          <TranslationButton t-if="isTranslatable"
                             fieldName="props.name"
                             record="props.record"/>
        </div>
      </div>
      <!--
        The preview reads the *record*, not the textarea, so it follows the
        toolbar and plain typing through the one path both already take. It is
        drawn as the chatter bubble a sent message becomes, so what an author
        checks here is what they will later see in the log.

        Placeholders stay unrendered on purpose: there is no record to render
        them against at this point, and showing `{{ object.name }}` as itself is
        honest about that where a fake value would not be.
      -->
      <div t-if="props.record.data[props.name]" class="o_whatsmeow_body_preview mt-2">
        <span class="o_whatsmeow_body_preview_label text-muted small">Preview</span>
        <div class="o_whatsmeow_body_preview_bubble" t-out="previewHtml"/>
      </div>
    </t>
  </t>

</templates>
