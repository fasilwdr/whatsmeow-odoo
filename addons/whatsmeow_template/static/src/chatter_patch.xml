<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

  <t t-inherit="mail.Chatter" t-inherit-mode="extension">
    <xpath expr="//button[hasclass('o-mail-Chatter-logNote')]" position="after">
      <button t-if="hasWhatsmeowButton"
              class="o-mail-Chatter-whatsmeow btn btn-secondary text-nowrap me-1"
              t-att-class="{ 'my-2': !props.compactHeight }"
              title="Send a WhatsApp message"
              t-on-click="onClickWhatsmeow">
        <i class="fa fa-whatsapp me-1" role="img"/>
        <span>WhatsApp</span>
      </button>
    </xpath>
  </t>

</templates>
