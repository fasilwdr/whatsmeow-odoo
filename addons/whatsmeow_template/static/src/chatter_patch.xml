<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

  <t t-inherit="mail.Chatter" t-inherit-mode="extension">
    <xpath expr="//button[hasclass('o-mail-Chatter-logNote')]" position="after">
      <button t-if="this.hasWhatsmeowButton"
              class="o-mail-Chatter-whatsmeow btn btn-secondary text-nowrap"
              title="Send a WhatsApp message"
              t-on-click="this.onClickWhatsmeow">
        <i class="oi me-1" data-icon="oi_whatsapp" role="img"/>
        <span>WhatsApp</span>
      </button>
    </xpath>
  </t>

</templates>
