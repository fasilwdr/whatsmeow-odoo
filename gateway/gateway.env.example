# Copy to gateway.env and fill in. install.sh generates this for you.
# Secrets: openssl rand -hex 32

WMG_LISTEN=127.0.0.1:8080
WMG_DATA_DIR=/var/lib/whatsmeow-gateway

# Who may use this gateway. Each Odoo database gets its own key and sees only
# the sessions started with it, so one gateway can serve several installs.
# WMG_API_KEY is the single-client form and is filed under the client name
# `default`; it keeps working forever, and an install that only ever serves one
# Odoo needs nothing else.
WMG_API_KEY=replace-with-openssl-rand-hex-32
# More clients: label:key pairs, comma separated. Labels are lowercase letters,
# digits, '-' and '_'. `install.sh --add-client <label>` writes this line.
#WMG_API_KEYS=acme:replace-with-openssl-rand-hex-32,globex:replace-with-openssl-rand-hex-32

# Where each session's events go is stored per session in
# $WMG_DATA_DIR/registry.json, pushed there by Odoo when the session starts.
# These two are only the defaults adopted, once, from a pre-registry install —
# a fresh multi-client gateway does not need them at all.
WMG_ODOO_WEBHOOK_URL=http://127.0.0.1:8069/whatsmeow/webhook
WMG_WEBHOOK_SECRET=replace-with-openssl-rand-hex-32

# Guard rails on the URLs clients may register. Defaults suit both shapes of
# install, so leave them alone unless the gateway tells you otherwise.
# Allow webhook URLs pointing into this host or its LAN. Defaults to true when
# WMG_LISTEN is loopback (a single-host install, where Odoo really is on
# 127.0.0.1) and false otherwise, because a shared gateway should not be
# talking to its own internal network on a client's say-so.
#WMG_WEBHOOK_ALLOW_PRIVATE=1
# Allow plain http to a public host. The webhook secret and every inbound
# message travel over it, so this is https-only unless you say otherwise.
#WMG_WEBHOOK_ALLOW_INSECURE=0
# Sessions one client may register.
#WMG_MAX_SESSIONS_PER_CLIENT=10

# Media (optional; defaults shown).
# Inbound media is downloaded into $WMG_DATA_DIR/media and fetched by Odoo, so
# this directory needs room for the files until Odoo collects them.
WMG_MAX_MEDIA_MB=100
# How long to keep media Odoo never collected before deleting it.
WMG_MEDIA_TTL_HOURS=24

# Recipient validation (optional; defaults shown).
# Asking WhatsApp whether a number is registered stops sends going into the
# void, but bulk-querying it is itself a bulk-sender fingerprint — so answers
# are cached and lookups are rationed per session.
# Days an answer is trusted. Must agree with REGISTRATION_TTL_DAYS in Odoo's
# whatsmeow_message.py, which is what stops it blocking a send.
WMG_CHECK_TTL_DAYS=30
# Numbers one request may ask about. Must stay >= CHECK_BATCH_SIZE in Odoo's
# whatsmeow_session.py, which chunks to this size.
WMG_CHECK_MAX_BATCH=50
# Uncached lookups a session may make per hour. Cached answers are free; over
# budget the reply is flagged `throttled` and Odoo comes back later.
WMG_CHECK_PER_HOUR=500

# Webhook delivery (optional; default shown).
# Each session has its own queue and its own sender goroutine, so one Odoo being
# down cannot hold up another client's events. This is the depth of one such
# queue. A full queue drops (with a log line) rather than blocking, because the
# events are produced on whatsmeow's event handler and blocking there stalls the
# WhatsApp connection itself.
WMG_WEBHOOK_QUEUE=512
