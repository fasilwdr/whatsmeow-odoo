[Unit]
Description=whatsmeow HTTP gateway for Odoo
After=network-online.target
Wants=network-online.target

[Service]
User=wagw
Group=wagw
EnvironmentFile=/opt/whatsmeow-gateway/gateway.env
ExecStart=/opt/whatsmeow-gateway/whatsmeow-gateway
Restart=always
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/whatsmeow-gateway
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
